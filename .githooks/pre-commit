#!/usr/bin/env bash
# pre-commit hook for Scholar Assistant
#
# 用途：commit 前自动检查暂存文件的代码质量，失败阻止提交
# 启用：npm run setup  (或手动 git config core.hooksPath .githooks)
# 跳过：git commit --no-verify  (紧急情况下使用，但不要养成习惯)
#
# 设计原则：
#   1. 只检查暂存文件（lint-staged 思路），避免全量扫描拖慢提交
#   2. 失败立即停止，给出清晰错误提示
#   3. 单次 hook 目标 < 5 秒
#   4. 兼容 Windows Git Bash / macOS / Linux

set -euo pipefail

# ── 颜色输出（Git Bash 兼容）─────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}[pre-commit]${NC} 检查暂存文件..."

# ── 收集暂存文件 ────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '^(dist|build|node_modules|src-tauri|python/data|python/logs|python/output|docs|outputs)/' || true)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}[pre-commit]${NC} 无需检查的文件，跳过"
  exit 0
fi

TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|vue)$' || true)
PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)

HAS_ERROR=0

# ── 前端：TypeScript 类型检查 ───────────────────────
# 注意：tsc 不能只检查单文件，必须全量。为提速，只在有 .ts/.vue 改动时跑。
if [ -n "$TS_FILES" ]; then
  echo -e "${BLUE}[pre-commit]${NC} TypeScript 类型检查..."
  if ! npx --no-install vue-tsc --noEmit 2>&1; then
    echo -e "${RED}[pre-commit]${NC} TypeScript 类型检查失败"
    HAS_ERROR=1
  fi
fi

# ── 前端：ESLint 检查暂存的 .ts/.vue 文件 ──────────
if [ -n "$TS_FILES" ]; then
  echo -e "${BLUE}[pre-commit]${NC} ESLint 检查 ${YELLOW}$(echo "$TS_FILES" | wc -l)${NC} 个前端文件..."
  # 用 $() 展开，shellcheck SC2086 警告在此场景可接受
  if ! npx --no-install eslint $TS_FILES 2>&1; then
    echo -e "${RED}[pre-commit]${NC} ESLint 检查失败，请运行 ${YELLOW}npm run lint:fix${NC} 修复"
    HAS_ERROR=1
  fi
fi

# ── 前端：Prettier 格式检查暂存文件 ─────────────────
if [ -n "$TS_FILES" ]; then
  echo -e "${BLUE}[pre-commit]${NC} Prettier 格式检查..."
  if ! npx --no-install prettier --check $TS_FILES 2>&1; then
    echo -e "${RED}[pre-commit]${NC} 格式检查失败，请运行 ${YELLOW}npm run format${NC} 修复"
    HAS_ERROR=1
  fi
fi

# ── 后端：Ruff 检查暂存的 .py 文件 ──────────────────
if [ -n "$PY_FILES" ]; then
  echo -e "${BLUE}[pre-commit]${NC} Ruff 检查 ${YELLOW}$(echo "$PY_FILES" | wc -l)${NC} 个 Python 文件..."
  # ruff check 支持多文件参数，且只检查这些文件
  # 注意：PY_FILES 路径以项目根为基准，ruff 在 python/ 子目录运行，需要处理路径
  # 简化处理：切到 python/ 目录，把路径前缀去掉
  PY_FILES_REL=$(echo "$PY_FILES" | sed 's|^python/||' || true)
  if [ -n "$PY_FILES_REL" ]; then
    if ! (cd python && python -m ruff check $PY_FILES_REL) 2>&1; then
      echo -e "${RED}[pre-commit]${NC} Ruff 检查失败，请运行 ${YELLOW}npm run py:lint:fix${NC} 修复"
      HAS_ERROR=1
    fi

    # Ruff format --check（只检查不修改）
    echo -e "${BLUE}[pre-commit]${NC} Ruff format 检查..."
    if ! (cd python && python -m ruff format --check $PY_FILES_REL) 2>&1; then
      echo -e "${RED}[pre-commit]${NC} 格式检查失败，请运行 ${YELLOW}npm run py:format${NC} 修复"
      HAS_ERROR=1
    fi
  fi
fi

# ── 结果汇总 ────────────────────────────────────────
if [ $HAS_ERROR -eq 1 ]; then
  echo ""
  echo -e "${RED}[pre-commit]${NC} 提交被拒绝。请修复以上问题后重新提交。"
  echo -e "${YELLOW}提示${NC}：紧急情况下可用 ${BLUE}git commit --no-verify${NC} 跳过检查（不推荐）"
  exit 1
fi

echo -e "${GREEN}[pre-commit]${NC} 所有检查通过 ✓"
exit 0
