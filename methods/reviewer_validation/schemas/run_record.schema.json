{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer-validation-run-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "run_id", "experiment", "stage", "condition", "paper_id", "pair_id", "venue_label", "checks", "protocol_version", "protocol_sha256", "code_commit", "started_at", "ended_at", "provider", "model", "generation", "steps", "output", "termination", "denominators"],
  "properties": {
    "schema_version": {"const": "reviewer-validation-run-record/v1"},
    "record_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1},
    "experiment": {"enum": ["rq1_ledger", "rq3_venue"]},
    "stage": {"enum": ["extraction", "gold_conditioned_status", "end_to_end", "venue_llm"]},
    "condition": {"enum": ["not_applicable", "generic", "venue_conditioned"]},
    "paper_id": {"type": "string", "minLength": 1}, "pair_id": {"type": ["string", "null"], "minLength": 1},
    "venue_label": {"type": ["string", "null"], "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["extraction", "discharge_classification", "llm"]}},
    "protocol_version": {"type": "string", "minLength": 1}, "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"},
    "provider": {"$ref": "#/$defs/provider"}, "model": {"$ref": "#/$defs/model"},
    "generation": {"$ref": "#/$defs/generation"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "output": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
    "termination": {"$ref": "#/$defs/termination"},
    "denominators": {"$ref": "#/$defs/denominators"}
  },
  "allOf": [
    {"if": {"properties": {"experiment": {"const": "rq1_ledger"}}, "required": ["experiment"]}, "then": {"properties": {"condition": {"const": "not_applicable"}, "pair_id": {"type": "null"}, "venue_label": {"type": "null"}}}},
    {"if": {"properties": {"experiment": {"const": "rq3_venue"}}, "required": ["experiment"]}, "then": {"properties": {"stage": {"const": "venue_llm"}, "condition": {"enum": ["generic", "venue_conditioned"]}, "pair_id": {"type": "string", "minLength": 1}, "venue_label": {"type": "string", "minLength": 1}, "checks": {"const": ["llm"]}}}},
    {"if": {"properties": {"stage": {"const": "extraction"}}, "required": ["stage"]}, "then": {"properties": {"checks": {"const": ["extraction"]}, "steps": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"phase": {"const": "extraction"}}}]}}}}},
    {"if": {"properties": {"stage": {"const": "gold_conditioned_status"}}, "required": ["stage"]}, "then": {"properties": {"checks": {"const": ["discharge_classification"]}, "steps": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"phase": {"const": "discharge_classification"}}}]}}}}},
    {"if": {"properties": {"stage": {"const": "end_to_end"}}, "required": ["stage"]}, "then": {"properties": {"checks": {"const": ["extraction", "discharge_classification"]}, "steps": {"minItems": 1, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"phase": {"const": "extraction"}}}]}, {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"phase": {"const": "discharge_classification"}}}]}], "items": false}}}},
    {"if": {"properties": {"stage": {"const": "venue_llm"}}, "required": ["stage"]}, "then": {"properties": {"steps": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/step"}, {"properties": {"phase": {"const": "venue_review"}}}]}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^methods/reviewer_validation/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["source_characters", "visible_characters", "truncated"],
      "properties": {"source_characters": {"type": "integer", "minimum": 0}, "visible_characters": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}
    },
    "inputSet": {
      "type": "object", "additionalProperties": false,
      "required": ["excerpt", "excerpt_coverage", "prompt", "profile", "gold_promises"],
      "properties": {
        "excerpt": {"$ref": "#/$defs/artifactRef"}, "excerpt_coverage": {"$ref": "#/$defs/coverage"},
        "prompt": {"$ref": "#/$defs/artifactRef"},
        "profile": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "gold_promises": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_number", "started_at", "ended_at", "status", "prompt", "request", "raw_response", "parsed_output", "error"],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1}, "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"$ref": "#/$defs/terminationStatus"},
        "prompt": {"$ref": "#/$defs/artifactRef"},
        "request": {"$ref": "#/$defs/artifactRef"},
        "raw_response": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "parsed_output": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["success", "legal_empty"]}}, "required": ["status"]}, "then": {"properties": {"error": {"type": "null"}, "raw_response": {"$ref": "#/$defs/artifactRef"}, "parsed_output": {"$ref": "#/$defs/artifactRef"}}}},
        {"if": {"properties": {"status": {"enum": ["empty_response", "invalid_json", "timeout", "provider_error", "classification_incomplete", "unknown_status"]}}, "required": ["status"]}, "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}}
      ]
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "phase", "inputs", "attempts", "termination"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["extraction", "discharge_classification", "venue_review"]},
        "inputs": {"$ref": "#/$defs/inputSet"},
        "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
        "termination": {"$ref": "#/$defs/termination"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "api_format", "client_count", "fallback_call_count"],
      "properties": {"name": {"type": "string", "minLength": 1}, "api_format": {"type": "string", "minLength": 1}, "client_count": {"const": 1}, "fallback_call_count": {"const": 0}}
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "snapshot"],
      "properties": {"id": {"type": "string", "minLength": 1}, "snapshot": {"type": ["string", "null"]}}
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature", "max_tokens", "thinking_mode", "seed", "json_mode"],
      "properties": {
        "temperature": {"type": "number"}, "max_tokens": {"type": "integer", "minimum": 1},
        "thinking_mode": {"type": ["string", "null"]}, "seed": {"type": ["integer", "null"], "minimum": 0}, "json_mode": {"type": "boolean"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "message_redacted"],
      "properties": {"type": {"type": "string", "minLength": 1}, "message_redacted": {"type": "string"}}
    },
    "terminationStatus": {"enum": ["success", "legal_empty", "empty_response", "invalid_json", "timeout", "provider_error", "classification_incomplete", "unknown_status"]},
    "termination": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "attempt_count", "error"],
      "properties": {
        "status": {"$ref": "#/$defs/terminationStatus"}, "attempt_count": {"type": "integer", "minimum": 1},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["success", "legal_empty"]}}, "required": ["status"]}, "then": {"properties": {"error": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["empty_response", "invalid_json", "timeout", "provider_error", "classification_incomplete", "unknown_status"]}}, "required": ["status"]}, "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}}
      ]
    },
    "denominators": {
      "type": "object", "additionalProperties": false,
      "required": ["planned_invocations", "primary_unit", "gold_occurrences", "prediction_occurrences", "applicable_criteria", "critique_units"],
      "properties": {
        "planned_invocations": {"const": 1}, "primary_unit": {"enum": ["paper", "review"]},
        "gold_occurrences": {"type": ["integer", "null"], "minimum": 0}, "prediction_occurrences": {"type": ["integer", "null"], "minimum": 0},
        "applicable_criteria": {"type": ["integer", "null"], "minimum": 0}, "critique_units": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
