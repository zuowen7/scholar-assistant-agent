{
  "name": "scholar-assistant",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack:python": "node scripts/build-python.cjs",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "py:lint": "ruff check python/",
    "py:lint:fix": "ruff check python/ --fix",
    "py:format": "ruff format python/",
    "py:format:check": "ruff format python/ --check",
    "py:test": "cd python && pytest tests/ -v",
    "py:test:unit": "cd python && pytest tests/unit/ -q",
    "setup": "node -e \"require('child_process').execSync('git config core.hooksPath .githooks', {stdio:'inherit'})\" && echo 'git hooks installed to .githooks/'",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.2",
    "monaco-editor": "^0.55.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/dagre": "^0.7.54",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.28.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "monaco-editor@^0.55.1": {
      "dompurify": "3.4.1"
    }
  }
}
